# Bootstrap profile 2 canonical K0-module graph lowerer.
# This rung accepts one P1 function with straight-line integer/local operations.
ve 3
cp 7

fn fail 0 0
  cu 1 cu 0 di re
fe

# take-uleb(buffer, cursor) -> (value << 21) | cursor
fn take-uleb 2 10
  cu 0 ls 2
  cu 0 ls 3
  cu 0 ls 4
  lg 0 bl ls 5
  lb take-byte
  lg 1 lg 5 eq bf take-have-byte
  ca fail re
  lb take-have-byte
  lg 0 lg 1 bg ls 6
  lg 1 cu 1 ad ls 1
  lg 6 cu 127 an ls 7
  lg 3 cu 63 eq bf take-shift
  cu 1 lg 7 lt bf take-shift
  ca fail re
  lb take-shift
  lg 7 lg 3 sl lg 2 or ls 2
  lg 4 cu 1 ad ls 4
  lg 6 cu 128 an cu 0 eq bf take-more
  lg 4 cu 1 eq bf take-terminal
  lg 2 cu 21 sl lg 1 or re
  lb take-terminal
  lg 7 cu 0 eq bf take-done
  ca fail re
  lb take-done
  lg 2 cu 21 sl lg 1 or re
  lb take-more
  lg 3 cu 7 ad ls 3
  cu 63 lg 3 lt bf take-byte
  ca fail re
fe

fn append-uleb 2 3
  lb append-loop
  lg 1 cu 127 an ls 2
  lg 1 cu 7 sr ls 1
  lg 1 cu 0 eq bf append-more
  ju append-byte
  lb append-more
  lg 2 cu 128 or ls 2
  lb append-byte
  lg 0 lg 2 bp ls 0
  lg 1 cu 0 eq bf append-loop
  lg 0 re
fe

# append-u24(layout, value) -> layout
fn append-u24 2 3
  lg 0 lg 1 cu 255 an bp ls 0
  lg 0 lg 1 cu 8 sr cu 255 an bp ls 0
  lg 0 lg 1 cu 16 sr cu 255 an bp re
fe

fn uleb-width 1 2
  cu 1 ls 1
  lb width-loop
  lg 0 cu 128 lt bf width-more
  lg 1 re
  lb width-more
  lg 0 cu 7 sr ls 0
  lg 1 cu 1 ad ls 1
  ju width-loop
fe

# layout-offset(layout, instruction-index) -> byte offset
fn layout-offset 2 5
  lg 1 cu 3 mu ls 2
  lg 0 lg 2 bg ls 3
  lg 0 lg 2 cu 1 ad bg cu 8 sl lg 3 or ls 3
  lg 0 lg 2 cu 2 ad bg cu 16 sl lg 3 or re
fe

# id-is(buffer, offset, low-16-bit identity) -> bool
fn id-is 3 7
  cu 0 ls 3
  lb id-prefix
  lg 3 cu 14 eq bf id-prefix-byte
  lg 0 lg 1 cu 14 ad bg lg 2 cu 8 sr cu 255 an eq bf id-false
  lg 0 lg 1 cu 15 ad bg lg 2 cu 255 an eq bf id-false
  cu 1 re
  lb id-prefix-byte
  lg 0 lg 1 lg 3 ad bg cu 0 eq bf id-false
  lg 3 cu 1 ad ls 3
  ju id-prefix
  lb id-false
  cu 0 re
fe

fn id-equal 4 7
  cu 0 ls 4
  lb equal-loop
  lg 4 cu 16 eq bf equal-byte
  cu 1 re
  lb equal-byte
  lg 0 lg 1 lg 4 ad bg
  lg 2 lg 3 lg 4 ad bg
  eq bf equal-false
  lg 4 cu 1 ad ls 4
  ju equal-loop
  lb equal-false
  cu 0 re
fe

# Find an instruction target in the complete function reference list.
fn reference-index 4 7
  cu 0 ls 4
  lb reference-loop
  lg 4 lg 3 eq bf reference-item
  ca fail re
  lb reference-item
  lg 1 lg 4 cu 17 mu ad cu 1 ad ls 5
  lg 0 lg 5 lg 0 lg 2 ca id-equal bf reference-next
  lg 4 re
  lb reference-next
  lg 4 cu 1 ad ls 4
  ju reference-loop
fe

# expect-id(buffer, cursor, low-16-bit identity) -> cursor + 16
fn expect-id 3 4
  lg 0 lg 1 lg 2 ca id-is bf expect-id-invalid
  lg 1 cu 16 ad re
  lb expect-id-invalid
  ca fail re
fe

# expect-byte(buffer, cursor, byte) -> cursor + 1
fn expect-byte 3 4
  lg 1 lg 0 bl eq bf expect-byte-room
  ca fail re
  lb expect-byte-room
  lg 0 lg 1 bg lg 2 eq bf expect-byte-invalid
  lg 1 cu 1 ad re
  lb expect-byte-invalid
  ca fail re
fe

# expect-uleb(buffer, cursor, value) -> cursor
fn expect-uleb 3 5
  lg 0 lg 1 ca take-uleb ls 3
  lg 3 cu 21 sr lg 2 eq bf expect-uleb-invalid
  lg 3 cu 2097151 an re
  lb expect-uleb-invalid
  ca fail re
fe

# Build one monotone instruction layout refinement. Each boundary is u24.
# build-layout(source, entity-start, count, refs-start, previous, refine)
fn build-layout 6 20
  cu 1048576 bn ls 6
  lg 1 ls 7
  cu 0 ls 8
  cu 0 ls 9
  lb build-layout-loop
  lg 8 lg 2 eq bf build-layout-item
  lg 6 lg 9 ca append-u24 re

  lb build-layout-item
  lg 6 lg 9 ca append-u24 ls 6
  # entity identity + Instruction schema + version
  lg 7 cu 16 ad ls 7
  lg 0 lg 7 cu 40978 ca expect-id ls 7
  lg 0 lg 7 cu 1 ca expect-uleb ls 7
  lg 0 lg 7 ca take-uleb ls 10
  lg 10 cu 21 sr ls 11
  lg 10 cu 2097151 an ls 7
  lg 0 lg 7 cu 41248 ca expect-id ls 7
  lg 0 lg 7 cu 3 ca expect-byte ls 7
  lg 0 lg 7 ca take-uleb ls 10
  lg 10 cu 21 sr ls 12
  lg 10 cu 2097151 an ls 7
  cu 1 ls 13

  # Numeric-operand instructions use the already canonical operand width.
  lg 12 cu 1 eq bf build-layout-local-get
  ju build-layout-operand
  lb build-layout-local-get
  lg 12 cu 2 eq bf build-layout-local-set
  ju build-layout-operand
  lb build-layout-local-set
  lg 12 cu 3 eq bf build-layout-branch
  ju build-layout-operand

  lb build-layout-operand
  lg 11 cu 2 eq bf build-layout-invalid
  lg 0 lg 7 cu 41249 ca expect-id ls 7
  lg 0 lg 7 cu 3 ca expect-byte ls 7
  lg 7 ls 14
  lg 0 lg 7 ca take-uleb ls 10
  lg 10 cu 2097151 an ls 7
  lg 7 lg 14 su lg 13 ad ls 13
  ju build-layout-next

  lb build-layout-branch
  lg 12 cu 32 eq bf build-layout-branch-false
  ju build-layout-target
  lb build-layout-branch-false
  lg 12 cu 33 eq bf build-layout-no-operand
  ju build-layout-target

  lb build-layout-target
  lg 11 cu 2 eq bf build-layout-invalid
  lg 0 lg 7 cu 41250 ca expect-id ls 7
  lg 0 lg 7 cu 6 ca expect-byte ls 7
  lg 0 lg 3 lg 7 lg 2 ca reference-index ls 15
  lg 15 ca uleb-width lg 13 ad ls 13
  lg 5 cu 0 eq bf build-layout-refined
  lg 13 cu 1 ad ls 13
  ju build-layout-target-done
  lb build-layout-refined
  lg 4 lg 15 ca layout-offset ca uleb-width lg 13 ad ls 13
  lb build-layout-target-done
  lg 7 cu 16 ad ls 7
  ju build-layout-next

  lb build-layout-no-operand
  lg 11 cu 1 eq bf build-layout-invalid
  lg 12 cu 0 eq bf build-layout-drop
  ju build-layout-next
  lb build-layout-drop
  lg 12 cu 4 eq bf build-layout-dup
  ju build-layout-next
  lb build-layout-dup
  lg 12 cu 5 eq bf build-layout-arithmetic-low
  ju build-layout-next
  lb build-layout-arithmetic-low
  lg 12 cu 16 lt bf build-layout-arithmetic-high
  ju build-layout-invalid
  lb build-layout-arithmetic-high
  lg 12 cu 28 lt bf build-layout-invalid
  ju build-layout-next

  lb build-layout-next
  lg 9 lg 13 ad ls 9
  lg 8 cu 1 ad ls 8
  ju build-layout-loop
  lb build-layout-invalid
  ca fail re
fe

fn main 0 20
  ac cu 2 eq bf lower-invalid
  cu 0 ag fr ls 0
  lg 0 bl ls 1
  cu 0 ls 2

  # Kernel envelope and K0 module identity.
  lg 0 lg 2 cu 83 ca expect-byte ls 2
  lg 0 lg 2 cu 69 ca expect-byte ls 2
  lg 0 lg 2 cu 77 ca expect-byte ls 2
  lg 0 lg 2 cu 69 ca expect-byte ls 2
  lg 0 lg 2 cu 75 ca expect-byte ls 2
  lg 0 lg 2 cu 49 ca expect-byte ls 2
  lg 0 lg 2 cu 13 ca expect-byte ls 2
  lg 0 lg 2 cu 10 ca expect-byte ls 2
  lg 0 lg 2 cu 1 ca expect-uleb ls 2
  lg 0 lg 2 cu 40960 ca expect-id ls 2
  # Revision identity is metadata for the derived artifact.
  lg 2 cu 16 ad ls 2
  lg 0 lg 2 cu 0 ca expect-uleb ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 12
  lg 6 cu 2097151 an ls 2

  # Program entity. Save its function reference at local 3.
  lg 2 cu 16 ad ls 2
  lg 0 lg 2 cu 40976 ca expect-id ls 2
  lg 0 lg 2 cu 1 ca expect-uleb ls 2
  lg 0 lg 2 cu 4 ca expect-uleb ls 2
  lg 0 lg 2 cu 41216 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 cu 2 ca expect-uleb ls 2
  lg 0 lg 2 cu 41217 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 cu 0 ca expect-uleb ls 2
  lg 0 lg 2 cu 41218 ca expect-id ls 2
  lg 0 lg 2 cu 7 ca expect-byte ls 2
  lg 0 lg 2 cu 1 ca expect-uleb ls 2
  lg 0 lg 2 cu 6 ca expect-byte ls 2
  lg 2 ls 3
  lg 2 cu 16 ad ls 2
  lg 0 lg 2 cu 41219 ca expect-id ls 2
  lg 0 lg 2 cu 6 ca expect-byte ls 2
  lg 0 lg 3 lg 0 lg 2 ca id-equal bf lower-invalid
  lg 2 cu 16 ad ls 2

  # Referenced function entity.
  lg 0 lg 3 lg 0 lg 2 ca id-equal bf lower-invalid
  lg 2 cu 16 ad ls 2
  lg 0 lg 2 cu 40977 ca expect-id ls 2
  lg 0 lg 2 cu 1 ca expect-uleb ls 2
  lg 0 lg 2 cu 3 ca expect-uleb ls 2
  lg 0 lg 2 cu 41232 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 13
  lg 6 cu 2097151 an ls 2
  lg 0 lg 2 cu 41233 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 14
  lg 6 cu 2097151 an ls 2
  lg 0 lg 2 cu 41234 ca expect-id ls 2
  lg 0 lg 2 cu 7 ca expect-byte ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 5
  lg 6 cu 2097151 an ls 2
  lg 5 cu 0 eq bf instruction-references
  ju lower-invalid

  # References are retained in the source graph while instruction entities are
  # parsed. Canonical entity order must match function instruction order in this
  # bootstrap profile; the general lowerer will use an identity table.
  lb instruction-references
  lg 2 ls 4
  cu 0 ls 11
  lb instruction-reference-loop
  lg 11 lg 5 eq bf instruction-reference
  ju instruction-entities-start
  lb instruction-reference
  lg 0 lg 2 cu 6 ca expect-byte ls 2
  lg 2 cu 16 ad ls 2
  lg 11 cu 1 ad ls 11
  ju instruction-reference-loop

  lb instruction-entities-start
  lg 5 cu 2 ad lg 12 eq bf lower-invalid
  lg 2 ls 16
  lg 0 lg 16 lg 5 lg 4 cu 0 cu 0 ca build-layout ls 17
  lg 0 lg 16 lg 5 lg 4 lg 17 cu 1 ca build-layout ls 17
  lg 0 lg 16 lg 5 lg 4 lg 17 cu 2 ca build-layout ls 17
  lg 0 lg 16 lg 5 lg 4 lg 17 cu 3 ca build-layout ls 17
  cu 1048576 bn ls 8
  cu 0 ls 11

  lb instruction-entity-loop
  lg 11 lg 5 eq bf instruction-entity
  ju instructions-finished

  lb instruction-entity
  # Reference offset = first tag + (index * 17) + 1.
  lg 4 lg 11 cu 17 mu ad cu 1 ad ls 16
  lg 0 lg 16 lg 0 lg 2 ca id-equal bf lower-invalid
  lg 2 cu 16 ad ls 2
  lg 0 lg 2 cu 40978 ca expect-id ls 2
  lg 0 lg 2 cu 1 ca expect-uleb ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 15
  lg 6 cu 2097151 an ls 2
  lg 0 lg 2 cu 41248 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 7
  lg 6 cu 2097151 an ls 2

  # Stable targets become derived indices and witnesses from the final layout.
  lg 7 cu 32 eq bf instruction-branch-false-check
  ju instruction-with-target
  lb instruction-branch-false-check
  lg 7 cu 33 eq bf instruction-operand-check
  ju instruction-with-target

  lb instruction-with-target
  lg 15 cu 2 eq bf lower-invalid
  lg 8 lg 7 bp ls 8
  lg 0 lg 2 cu 41250 ca expect-id ls 2
  lg 0 lg 2 cu 6 ca expect-byte ls 2
  lg 0 lg 4 lg 2 lg 5 ca reference-index ls 18
  lg 8 lg 18 ca append-uleb ls 8
  lg 17 lg 18 ca layout-offset ls 19
  lg 8 lg 19 ca append-uleb ls 8
  lg 2 cu 16 ad ls 2
  ju instruction-next

  # Operand-bearing straight-line instructions: const.u, local.get, local.set.
  lb instruction-operand-check
  lg 7 cu 1 eq bf instruction-local-get
  ju instruction-with-operand
  lb instruction-local-get
  lg 7 cu 2 eq bf instruction-local-set
  ju instruction-with-operand
  lb instruction-local-set
  lg 7 cu 3 eq bf instruction-no-operand
  ju instruction-with-operand

  lb instruction-with-operand
  lg 15 cu 2 eq bf lower-invalid
  lg 8 lg 7 bp ls 8
  lg 0 lg 2 cu 41249 ca expect-id ls 2
  lg 0 lg 2 cu 3 ca expect-byte ls 2
  lg 0 lg 2 ca take-uleb ls 6
  lg 6 cu 21 sr ls 7
  lg 6 cu 2097151 an ls 2
  lg 8 lg 7 ca append-uleb ls 8
  ju instruction-next

  lb instruction-no-operand
  lg 15 cu 1 eq bf lower-invalid
  # return, drop, dup, and integer arithmetic/comparison opcodes.
  lg 7 cu 0 eq bf instruction-drop-check
  ju instruction-append
  lb instruction-drop-check
  lg 7 cu 4 eq bf instruction-dup-check
  ju instruction-append
  lb instruction-dup-check
  lg 7 cu 5 eq bf instruction-arithmetic-lower
  ju instruction-append
  lb instruction-arithmetic-lower
  lg 7 cu 16 lt bf instruction-arithmetic-upper
  ju lower-invalid
  lb instruction-arithmetic-upper
  lg 7 cu 28 lt bf lower-invalid
  ju instruction-append
  lb instruction-append
  lg 8 lg 7 bp ls 8

  lb instruction-next
  lg 11 cu 1 ad ls 11
  ju instruction-entity-loop

  lb instructions-finished
  lg 2 lg 1 eq bf lower-invalid

  # Build the derived P1 image and derive code size from the code buffer.
  lg 8 bl ls 9

  cu 128 bn ls 10
  lg 10 cu 83 bp ls 10
  lg 10 cu 69 bp ls 10
  lg 10 cu 77 bp ls 10
  lg 10 cu 69 bp ls 10
  lg 10 cu 45 bp ls 10
  lg 10 cu 75 bp ls 10
  lg 10 cu 48 bp ls 10
  lg 10 cu 0 bp ls 10
  lg 10 cu 2 ca append-uleb ls 10
  lg 10 cu 1 ca append-uleb ls 10
  lg 10 lg 13 ca append-uleb ls 10
  lg 10 lg 14 ca append-uleb ls 10
  lg 10 lg 5 ca append-uleb ls 10
  lg 10 lg 9 ca append-uleb ls 10
  cu 0 ls 11
  lb copy-code
  lg 11 lg 9 eq bf copy-code-byte
  ju write-entry
  lb copy-code-byte
  lg 10 lg 8 lg 11 bg bp ls 10
  lg 11 cu 1 ad ls 11
  ju copy-code
  lb write-entry
  lg 10 cu 0 ca append-uleb ls 10
  cu 1 ag lg 10 fw re

  lb lower-invalid
  ca fail re
fe

en main
