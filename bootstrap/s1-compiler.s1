# Values above 65535 are parser markers, not K0 instructions.
fn directive-info 1 1
  lg 0
  cu 29285
  eq
  bf info-cu
  cu 0
  re
  lb info-cu
  lg 0
  cu 25461
  eq
  bf info-lg
  cu 257
  re
  lb info-lg
  lg 0
  cu 27751
  eq
  bf info-ls
  cu 513
  re
  lb info-ls
  lg 0
  cu 27763
  eq
  bf info-dr
  cu 769
  re
  lb info-dr
  lg 0
  cu 25714
  eq
  bf info-du
  cu 1024
  re
  lb info-du
  lg 0
  cu 25717
  eq
  bf info-ad
  cu 1280
  re
  lb info-ad
  lg 0
  cu 24932
  eq
  bf info-su
  cu 4096
  re
  lb info-su
  lg 0
  cu 29557
  eq
  bf info-mu
  cu 4352
  re
  lb info-mu
  lg 0
  cu 28021
  eq
  bf info-di
  cu 4608
  re
  lb info-di
  lg 0
  cu 25705
  eq
  bf info-rm
  cu 4864
  re
  lb info-rm
  lg 0
  cu 29293
  eq
  bf info-an
  cu 5120
  re
  lb info-an
  lg 0
  cu 24942
  eq
  bf info-or
  cu 5376
  re
  lb info-or
  lg 0
  cu 28530
  eq
  bf info-xo
  cu 5632
  re
  lb info-xo
  lg 0
  cu 30831
  eq
  bf info-sl
  cu 5888
  re
  lb info-sl
  lg 0
  cu 29548
  eq
  bf info-sr
  cu 6144
  re
  lb info-sr
  lg 0
  cu 29554
  eq
  bf info-eq
  cu 6400
  re
  lb info-eq
  lg 0
  cu 25969
  eq
  bf info-lt
  cu 6656
  re
  lb info-lt
  lg 0
  cu 27764
  eq
  bf info-ju
  cu 6912
  re
  lb info-ju
  lg 0
  cu 27253
  eq
  bf info-bf
  cu 8194
  re
  lb info-bf
  lg 0
  cu 25190
  eq
  bf info-ca
  cu 8450
  re
  lb info-ca
  lg 0
  cu 25441
  eq
  bf info-bl
  cu 12291
  re
  lb info-bl
  lg 0
  cu 25196
  eq
  bf info-bg
  cu 16384
  re
  lb info-bg
  lg 0
  cu 25191
  eq
  bf info-bn
  cu 16640
  re
  lb info-bn
  lg 0
  cu 25198
  eq
  bf info-bp
  cu 16896
  re
  lb info-bp
  lg 0
  cu 25200
  eq
  bf info-ac
  cu 17152
  re
  lb info-ac
  lg 0
  cu 24931
  eq
  bf info-ag
  cu 24576
  re
  lb info-ag
  lg 0
  cu 24935
  eq
  bf info-fr
  cu 24832
  re
  lb info-fr
  lg 0
  cu 26226
  eq
  bf info-fw
  cu 25088
  re
  lb info-fw
  lg 0
  cu 26231
  eq
  bf info-lb
  cu 25344
  re
  lb info-lb
  lg 0
  cu 27746
  eq
  bf info-fe
  cu 65537
  re
  lb info-fe
  lg 0
  cu 26213
  eq
  bf info-invalid
  cu 65538
  re
  lb info-invalid
  cu 1
  cu 0
  di
  re
fe

# scan-body(buffer, cursor-after-function-header)
#   -> (cursor-after-fe << 21) | instruction-count
fn scan-body 2 9
  cu 0
  ls 2

  lb scan-body-loop
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 0
  lg 3
  ca token-code
  ca directive-info
  ls 4

  lg 4
  cu 65538
  eq
  bf scan-body-label
  lg 1
  cu 21
  sl
  lg 2
  or
  re

  lb scan-body-label
  lg 4
  cu 65537
  eq
  bf scan-body-instruction
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  ju scan-body-loop

  lb scan-body-instruction
  lg 4
  cu 255
  an
  ls 5
  lg 5
  cu 0
  eq
  bf scan-body-operand
  ju scan-body-count

  lb scan-body-operand
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 5
  cu 1
  eq
  bf scan-body-count
  lg 0
  lg 3
  ca parse-u64
  dr

  lb scan-body-count
  lg 2
  cu 1
  ad
  ls 2
  cu 65535
  lg 2
  lt
  bf scan-body-loop
  cu 1
  cu 0
  di
  re
fe

# parse-header(buffer) -> (cursor-after-header << 3) | capability mask
fn parse-header 1 6
  cu 0
  ls 1
  lg 0
  lg 1
  ca next-token
  ls 2
  lg 2
  cu 42
  sr
  ls 1
  lg 0
  lg 2
  ca token-code
  cu 30309
  eq
  bf header-invalid
  lg 0
  lg 1
  ca next-token
  ls 2
  lg 2
  cu 42
  sr
  ls 1
  lg 0
  lg 2
  ca parse-u64
  cu 3
  eq
  bf header-invalid

  lg 0
  lg 1
  ca next-token
  ls 2
  lg 2
  cu 42
  sr
  ls 1
  lg 0
  lg 2
  ca token-code
  cu 25456
  eq
  bf header-invalid
  lg 0
  lg 1
  ca next-token
  ls 2
  lg 2
  cu 42
  sr
  ls 1
  lg 0
  lg 2
  ca parse-u64
  ls 3
  cu 7
  lg 3
  lt
  bf header-valid

  lb header-invalid
  cu 1
  cu 0
  di
  re

  lb header-valid
  lg 1
  cu 3
  sl
  lg 3
  or
  re
fe

# count-functions(buffer, cursor-after-header) -> declared function count
fn count-functions 2 12
  cu 0
  ls 2

  lb count-function-loop
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 0
  lg 3
  ca token-code
  ls 4
  lg 4
  cu 25966
  eq
  bf count-expect-function
  lg 0
  lg 1
  ca next-token
  dr
  lg 2
  cu 0
  eq
  bf count-done
  ju count-invalid

  lb count-expect-function
  lg 4
  cu 26222
  eq
  bf count-invalid
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 0
  lg 3
  ca parse-u64
  ls 5
  lg 0
  lg 1
  ca next-token
  ls 3
  lg 3
  cu 42
  sr
  ls 1
  lg 0
  lg 3
  ca parse-u64
  ls 6
  cu 64
  lg 6
  lt
  bf count-params
  ju count-invalid
  lb count-params
  lg 6
  lg 5
  lt
  bf count-scan-body
  ju count-invalid

  lb count-scan-body
  lg 0
  lg 1
  ca scan-body
  ls 7
  lg 7
  cu 21
  sr
  ls 1
  lg 2
  cu 1
  ad
  ls 2
  cu 16
  lg 2
  lt
  bf count-function-loop

  lb count-invalid
  cu 1
  cu 0
  di
  re

  lb count-done
  lg 2
  re
fe

# function-index(buffer, cursor-after-header, name-span) -> declaration index
fn function-index 3 10
  cu 0
  ls 3

  lb function-index-loop
  lg 0
  lg 1
  ca next-token
  ls 4
  lg 4
  cu 42
  sr
  ls 1
  lg 0
  lg 4
  ca token-code
  cu 26222
  eq
  bf function-index-missing

  lg 0
  lg 1
  ca next-token
  ls 5
  lg 5
  cu 42
  sr
  ls 1
  lg 0
  lg 5
  lg 2
  ca token-equal
  bf function-index-skip-header
  lg 3
