  ca next-token
  ls 4
  lg 4
  cu 42
  sr
  ls 1
  lg 0
  lg 1
  ca next-token
  ls 4
  lg 4
  cu 42
  sr
  ls 1
  lg 0
  lg 1
  ca scan-body
  ls 6
  lg 6
  cu 21
  sr
  ls 1
  lg 3
  cu 1
  ad
  ls 3
  ju function-index-loop

  lb function-index-missing
  cu 1
  cu 0
  di
  re
fe

