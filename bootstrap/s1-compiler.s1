# Portable symbolic S1 compiler.
#
# Token spans pack cursor/start/length into three 21-bit fields:
#   (cursor << 42) | (start << 21) | length
# This covers every position in a maximum-size K0 byte buffer, including EOF.

ve 3
cp 7

# next-token(buffer, cursor) -> packed span
fn next-token 2 7
  lg 0
  bl
  ls 2

  lb skip
  lg 1
  lg 2
  eq
  bf have-skip-byte
  cu 1
  cu 0
  di
  re

  lb have-skip-byte
  lg 0
  lg 1
  bg
  ls 3
  lg 3
  cu 35
  eq
  bf whitespace

  lb comment
  lg 1
  cu 1
  ad
  ls 1
  lg 1
  lg 2
  eq
  bf comment-byte
  ju skip

  lb comment-byte
  lg 0
  lg 1
  bg
  cu 10
  eq
  bf comment
  lg 1
  cu 1
  ad
  ls 1
  ju skip

  lb whitespace
  lg 3
  cu 33
  lt
  bf token-start
  lg 1
  cu 1
  ad
  ls 1
  ju skip

  lb token-start
  lg 1
  ls 4

  lb token-loop
  lg 1
  lg 2
  eq
  bf token-byte
  ju token-done

  lb token-byte
  lg 0
  lg 1
  bg
  ls 3
  lg 3
  cu 33
  lt
  bf token-comment-check
  ju token-done

  lb token-comment-check
  lg 3
  cu 35
  eq
  bf token-advance
  ju token-done

  lb token-advance
  lg 1
  cu 1
  ad
  ls 1
  ju token-loop

  lb token-done
  lg 1
  lg 4
  su
  ls 5
  lg 1
  cu 42
  sl
  lg 4
  cu 21
  sl
  or
  lg 5
  or
  re
fe

# token-code(buffer, span) -> big-endian two-byte directive code
fn token-code 2 5
  lg 1
  cu 2097151
  an
  cu 2
  eq
  bf token-code-invalid
  lg 1
  cu 21
  sr
  cu 2097151
  an
  ls 2
  lg 0
  lg 2
  bg
  cu 256
  mu
  lg 0
  lg 2
  cu 1
  ad
  bg
  ad
  re

  lb token-code-invalid
  cu 1
  cu 0
  di
  re
fe

# token-equal(buffer, left-span, right-span) -> bool
fn token-equal 3 8
  lg 1
  cu 2097151
  an
  ls 3
  lg 2
  cu 2097151
  an
  ls 4
  lg 3
  lg 4
  eq
  bf token-not-equal
  lg 1
  cu 21
  sr
  cu 2097151
  an
  ls 5
  lg 2
  cu 21
  sr
  cu 2097151
  an
  ls 6
  cu 0
  ls 7

  lb equal-loop
  lg 7
  lg 3
  eq
  bf equal-byte
  cu 1
  re

  lb equal-byte
  lg 0
  lg 5
  lg 7
  ad
  bg
  lg 0
  lg 6
  lg 7
  ad
  bg
  eq
  bf token-not-equal
  lg 7
  cu 1
  ad
  ls 7
  ju equal-loop

  lb token-not-equal
  cu 0
  re
fe

# parse-u64(buffer, span) -> exact unsigned value; invalid input traps.
fn parse-u64 2 9
  lg 1
  cu 2097151
  an
  ls 2
  lg 1
  cu 21
  sr
  cu 2097151
  an
  ls 3
  lg 2
  cu 0
  eq
  bf decimal-first-byte
  cu 1
  cu 0
  di
  re

  lb decimal-first-byte
  lg 0
  lg 3
  bg
  cu 48
  eq
  bf decimal-init
  lg 2
  cu 1
  eq
  bf decimal-invalid
  cu 0
  re

  lb decimal-init
  cu 0
  ls 4
  cu 0
  ls 5

  lb decimal-loop
  lg 5
  lg 2
  eq
  bf decimal-byte
  lg 4
  re

  lb decimal-byte
  lg 0
  lg 3
  lg 5
  ad
  bg
  ls 6
  lg 6
  cu 48
  lt
  bf decimal-upper
  cu 1
  cu 0
  di
  re

  lb decimal-upper
  lg 6
  cu 58
  lt
  bf decimal-invalid
  lg 6
  cu 48
  su
  ls 7

  # Reject accumulator * 10 + digit above 2^64 - 1.
  cu 1844674407370955161
  lg 4
  lt
  bf decimal-max-equal
  ju decimal-invalid

  lb decimal-max-equal
  lg 4
  cu 1844674407370955161
  eq
  bf decimal-safe
  cu 5
  lg 7
  lt
  bf decimal-safe
  ju decimal-invalid

  lb decimal-safe
  lg 4
  cu 10
  mu
  lg 7
  ad
  ls 4
  lg 5
  cu 1
  ad
  ls 5
  ju decimal-loop

  lb decimal-invalid
  cu 1
  cu 0
  di
  re
fe

