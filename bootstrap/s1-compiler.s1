# build-layout(source, header-cursor, refinement, previous-layout) -> layout
# Stores every function's semantic instruction boundaries as packed u24 values.
fn build-layout 4 24
  cu 1048576
  bn
  ls 4
  lg 1
  ls 5
  cu 0
  ls 6

  lb layout-function-loop
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  lg 0
  lg 7
  ca token-code
  ls 8
  lg 8
  cu 25966
  eq
  bf layout-expect-function
  lg 4
  re

  lb layout-expect-function
  lg 8
  cu 26222
  eq
  bf layout-invalid
  # Skip name, parameters, and locals; the validation pass parsed them.
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  lg 5
  ls 10
  lg 0
  lg 10
  ca scan-body
  ls 11
  lg 11
  cu 2097151
  an
  ls 12
  cu 0
  ls 13
  cu 0
  ls 14

  lb layout-instruction-loop
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  lg 0
  lg 7
  ca token-code
  ca directive-info
  ls 8
  lg 8
  cu 65538
  eq
  bf layout-label
  # Append the epilogue boundary.
  lg 4
  lg 13
  cu 255
  an
  bp
  ls 4
  lg 4
  lg 13
  cu 8
  sr
  cu 255
  an
  bp
  ls 4
  lg 4
  lg 13
  cu 16
  sr
  cu 255
  an
  bp
  ls 4
  lg 6
  lg 12
  cu 1
  ad
  ad
  ls 6
  ju layout-function-loop

  lb layout-label
  lg 8
  cu 65537
  eq
  bf layout-instruction
  lg 0
  lg 5
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 5
  ju layout-instruction-loop

  lb layout-instruction
  # Append this instruction boundary.
  lg 4
  lg 13
  cu 255
  an
  bp
  ls 4
  lg 4
  lg 13
  cu 8
  sr
  cu 255
  an
  bp
  ls 4
  lg 4
  lg 13
  cu 16
  sr
  cu 255
  an
  bp
  ls 4
  lg 13
  cu 1
  ad
  ls 13
  lg 8
  cu 255
  an
  ls 15

  # Source return is encoded as jump(count, epilogue witness).
  lg 8
  cu 0
  eq
  bf layout-kind
  lg 12
  ca uleb-width
  lg 13
  ad
  ls 13
  lg 2
  cu 0
  eq
  bf layout-return-refined
  lg 13
  cu 1
  ad
  ls 13
  ju layout-count

  lb layout-return-refined
  lg 3
  lg 6
  lg 12
  ca code-offset
  ca uleb-width
  lg 13
  ad
  ls 13
  ju layout-count

  lb layout-kind
  lg 15
  cu 0
  eq
  bf layout-operand
  ju layout-count

  lb layout-operand
  lg 0
  lg 5
  ca next-token
  ls 16
  lg 16
  cu 42
  sr
  ls 5
  lg 15
  cu 1
  eq
  bf layout-label-operand
  lg 0
  lg 16
  ca parse-u64
  ca uleb-width
  lg 13
  ad
  ls 13
  ju layout-count

  lb layout-label-operand
  lg 15
  cu 2
  eq
  bf layout-function-operand
  lg 0
  lg 10
  lg 16
  ca label-index
  ls 17
  lg 17
  ca uleb-width
  lg 13
  ad
  ls 13
  lg 2
  cu 0
  eq
  bf layout-label-refined
  lg 13
  cu 1
  ad
  ls 13
  ju layout-count

  lb layout-label-refined
  lg 3
  lg 6
  lg 17
  ca code-offset
  ca uleb-width
  lg 13
  ad
  ls 13
  ju layout-count

  lb layout-function-operand
  lg 15
  cu 3
  eq
  bf layout-invalid
  lg 0
  lg 1
  lg 16
  ca function-index
  ca uleb-width
  lg 13
  ad
  ls 13

  lb layout-count
  lg 14
  cu 1
  ad
  ls 14
  ju layout-instruction-loop

  lb layout-invalid
  cu 1
  cu 0
  di
  re
fe

# append-uleb(buffer, value) -> buffer
fn append-uleb 2 3
  lb append-uleb-loop
  lg 1
  cu 127
  an
  ls 2
