  lg 0
  re
fe

fn main 0 24
  cu 0
  ag
  fr
  ls 0
  lg 0
  ca parse-header
  ls 2
  lg 2
  cu 3
  sr
  ls 3
  lg 2
  cu 7
  an
  ls 4
  lg 0
  lg 3
  ca count-functions
  ls 5

  # Four monotone layout refinements: assumed width one, then three derived.
  lg 0
  lg 3
  cu 0
  cu 0
  ca build-layout
  ls 22
  lg 0
  lg 3
  cu 1
  lg 22
  ca build-layout
  ls 22
  lg 0
  lg 3
  cu 2
  lg 22
  ca build-layout
  ls 22
  lg 0
  lg 3
  cu 3
  lg 22
  ca build-layout
  ls 22
  cu 0
  ls 23

  cu 1048576
  bn
  ls 1
  lg 1
  cu 83
  bp
  ls 1
  lg 1
  cu 69
  bp
  ls 1
  lg 1
  cu 77
  bp
  ls 1
  lg 1
  cu 69
  bp
  ls 1
  lg 1
  cu 45
  bp
  ls 1
  lg 1
  cu 75
  bp
  ls 1
  lg 1
  cu 48
  bp
  ls 1
  lg 1
  cu 0
  bp
  ls 1
  lg 1
  cu 3
  ca append-uleb
  ls 1
  lg 1
  lg 4
  ca append-uleb
  ls 1
  lg 1
  lg 5
  ca append-uleb
  ls 1
  lg 3
  ls 6

  lb emit-function-loop
  lg 0
  lg 6
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 6
  lg 0
  lg 7
  ca token-code
  ls 8
  lg 8
  cu 25966
  eq
  bf emit-expect-function
  ju emit-entry

  lb emit-expect-function
  lg 8
  cu 26222
  eq
  bf emit-invalid
  # Function name is consumed; declaration order is already validated.
  lg 0
  lg 6
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 6
  lg 0
  lg 6
  ca next-token
  ls 7
  lg 7
  cu 42
  sr
  ls 6
  lg 0
  lg 7
